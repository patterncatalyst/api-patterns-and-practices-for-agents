# Build context is examples/ so the shared domain model can be installed first.
#   docker build -f 31-publish-the-tool-surface/Containerfile -t publish-the-tool-surface:1.0.0 examples
#
# This ONE image is the whole point: run it detached (-d, the compose service) and it serves
# Streamable HTTP; run it attached (`docker run -i`) with QUARKUS_MCP_SERVER_STDIO_ENABLED=true
# and the SAME fast-jar serves the identical tool surface over stdin/stdout instead. There is
# only one build, so there is only one version to drift.
FROM registry.access.redhat.com/ubi10/openjdk-25:1.24-20 AS build
USER 185
WORKDIR /build
COPY --chown=185:0 domain-model/ domain-model/
COPY --chown=185:0 31-publish-the-tool-surface/pom.xml 31-publish-the-tool-surface/pom.xml
COPY --chown=185:0 31-publish-the-tool-surface/src 31-publish-the-tool-surface/src
RUN mvn -B -ntp -q -f domain-model/pom.xml install -DskipTests \
 && mvn -B -ntp -q -f 31-publish-the-tool-surface/pom.xml package -DskipTests

FROM registry.access.redhat.com/ubi10/openjdk-25-runtime:1.24-20
ENV JAVA_APP_JAR=/deployments/quarkus-run.jar \
    JAVA_OPTS_APPEND="-Dquarkus.http.host=0.0.0.0 -Djava.util.logging.manager=org.jboss.logmanager.LogManager"
COPY --from=build --chown=185 /build/31-publish-the-tool-surface/target/quarkus-app/lib/ /deployments/lib/
COPY --from=build --chown=185 /build/31-publish-the-tool-surface/target/quarkus-app/*.jar /deployments/
COPY --from=build --chown=185 /build/31-publish-the-tool-surface/target/quarkus-app/app/ /deployments/app/
COPY --from=build --chown=185 /build/31-publish-the-tool-surface/target/quarkus-app/quarkus/ /deployments/quarkus/
EXPOSE 8080
USER 185
