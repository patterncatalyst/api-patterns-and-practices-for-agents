# Build context is the repo root, so the shared domain model and the committed
# contracts/15-payment.proto both resolve; the committed proto overwrites the module's own copy
# at build time, so the image always compiles the one contract on record.
#   docker build -f examples/15-reshape-grpc-behind-facade/payment-service/Containerfile \
#     -t payment-service .
FROM registry.access.redhat.com/ubi10/openjdk-25:1.24-20 AS build
USER 185
WORKDIR /build
COPY --chown=185:0 examples/domain-model/ domain-model/
COPY --chown=185:0 examples/15-reshape-grpc-behind-facade/payment-service/pom.xml payment-service/pom.xml
COPY --chown=185:0 examples/15-reshape-grpc-behind-facade/payment-service/src payment-service/src
COPY --chown=185:0 contracts/15-payment.proto payment-service/src/main/proto/payment.proto
RUN mvn -B -ntp -q -f domain-model/pom.xml install -DskipTests \
 && mvn -B -ntp -q -f payment-service/pom.xml package -DskipTests

FROM registry.access.redhat.com/ubi10/openjdk-25-runtime:1.24-20
ENV JAVA_APP_JAR=/deployments/quarkus-run.jar \
    JAVA_OPTS_APPEND="-Dquarkus.http.host=0.0.0.0 -Dquarkus.grpc.server.host=0.0.0.0 -Djava.util.logging.manager=org.jboss.logmanager.LogManager"
COPY --from=build --chown=185 /build/payment-service/target/quarkus-app/lib/ /deployments/lib/
COPY --from=build --chown=185 /build/payment-service/target/quarkus-app/*.jar /deployments/
COPY --from=build --chown=185 /build/payment-service/target/quarkus-app/app/ /deployments/app/
COPY --from=build --chown=185 /build/payment-service/target/quarkus-app/quarkus/ /deployments/quarkus/
EXPOSE 8080 9000
USER 185
