{
  "realm": "apa",
  "enabled": true,
  "sslRequired": "none",
  "accessTokenLifespan": 600,
  "registrationAllowed": false,
  "roles": {
    "realm": [
      {
        "name": "agent",
        "description": "An AI agent calling the book's MCP tool surface on its own behalf"
      }
    ]
  },
  "clientScopes": [
    {
      "name": "roles",
      "description": "Realm role claim, so the agent's token carries its assigned realm role",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "false",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "realm roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "foo",
            "access.token.claim": "true",
            "claim.name": "realm_access.roles",
            "jsonType.label": "String",
            "multivalued": "true"
          }
        }
      ]
    },
    {
      "name": "mcp:tools:read",
      "description": "Call a read-only MCP tool",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      }
    },
    {
      "name": "mcp:tools:write",
      "description": "Call an MCP tool that changes state",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      }
    },
    {
      "name": "step-up-acr",
      "description": "r11 (ch35): stamps a high-assurance acr claim and the apa-mcp audience onto a token traded through RFC 8693 token exchange. Not a readable scope (include.in.token.scope false, like roles): two protocol mappers, no caller-visible permission.",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "false",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "step-up acr",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "acr",
            "claim.value": "urn:patterncatalyst:acr:step-up",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        },
        {
          "name": "apa-mcp audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "apa-mcp",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ],
  "clients": [
    {
      "clientId": "apa-mcp",
      "description": "Lab only: confidential client authenticating with the client_credentials grant (service account), so an agent can fetch a token with one request.",
      "enabled": true,
      "publicClient": false,
      "secret": "apa-mcp-dev-secret",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "protocol": "openid-connect",
      "defaultClientScopes": [
        "roles"
      ],
      "optionalClientScopes": [
        "mcp:tools:read",
        "mcp:tools:write"
      ]
    },
    {
      "clientId": "apa-agent-bff",
      "description": "r11 (ch35) lab only: confidential requester for RFC 8693 standard token exchange (v2). Exchanges its own low-assurance mcp:tools:read token for a step-up, mcp:tools:write token.",
      "enabled": true,
      "publicClient": false,
      "secret": "apa-agent-bff-dev-secret",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "protocol": "openid-connect",
      "attributes": {
        "standard.token.exchange.enabled": "true"
      },
      "defaultClientScopes": [
        "roles"
      ],
      "optionalClientScopes": [
        "mcp:tools:read",
        "mcp:tools:write",
        "step-up-acr"
      ]
    }
  ],
  "users": [
    {
      "username": "service-account-apa-mcp",
      "enabled": true,
      "serviceAccountClientId": "apa-mcp",
      "realmRoles": [
        "agent"
      ]
    },
    {
      "username": "service-account-apa-agent-bff",
      "enabled": true,
      "serviceAccountClientId": "apa-agent-bff",
      "realmRoles": [
        "agent"
      ]
    }
  ]
}
