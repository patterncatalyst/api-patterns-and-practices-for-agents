# Build context is examples/ so the build stage has a stable, repo-relative layout.
#   docker build -f ag-structured-outputs/Containerfile -t structured-outputs examples
FROM registry.access.redhat.com/ubi10/openjdk-25:1.24-20 AS build
USER 185
WORKDIR /build
COPY --chown=185:0 ag-structured-outputs/pom.xml ag-structured-outputs/pom.xml
COPY --chown=185:0 ag-structured-outputs/src ag-structured-outputs/src
RUN mvn -B -ntp -q -f ag-structured-outputs/pom.xml package -DskipTests

FROM registry.access.redhat.com/ubi10/openjdk-25-runtime:1.24-20
ENV JAVA_APP_JAR=/deployments/quarkus-run.jar \
    JAVA_OPTS_APPEND="-Dquarkus.http.host=0.0.0.0 -Djava.util.logging.manager=org.jboss.logmanager.LogManager"
COPY --from=build --chown=185 /build/ag-structured-outputs/target/quarkus-app/lib/ /deployments/lib/
COPY --from=build --chown=185 /build/ag-structured-outputs/target/quarkus-app/*.jar /deployments/
COPY --from=build --chown=185 /build/ag-structured-outputs/target/quarkus-app/app/ /deployments/app/
COPY --from=build --chown=185 /build/ag-structured-outputs/target/quarkus-app/quarkus/ /deployments/quarkus/
EXPOSE 8080
USER 185
